# ── Frontend (Vite) — variáveis VITE_* ficam na raiz (.env.local) ──────────
# Flag da feature ficha de personagem (login-gate + card + telas).
# Default OFF: o site de produção continua exatamente como está.
VITE_ENABLE_SHEET_CREATOR=false

# ── Backend — copie para backend/.env ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# Postgres local do compose.dev.yaml (porta 5433)
DATABASE_URL=postgresql://rpgmap:rpgmap_dev@localhost:5433/rpgmap?schema=public

# Origem do frontend (CORS + links do magic link)
WEB_URL=http://localhost:5173

LOG_LEVEL=info

# E-mail — dev: Mailpit (SMTP :1025, UI :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@rpg-map.local
# SMTP_USER=
# SMTP_PASS=

# Banco de testes (separado do dev) — usado pelo vitest do backend
DATABASE_URL_TEST=postgresql://rpgmap:rpgmap_dev@localhost:5433/rpgmap_test?schema=public
